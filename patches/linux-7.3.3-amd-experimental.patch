+static int rdtsc_experiment_interception(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_svm *svm = to_svm(vcpu);
+	u64 now, delta;
+
+	if (svm_get_cpl(vcpu) && (kvm_read_cr4(vcpu) & X86_CR4_TSD)) {
+		kvm_inject_gp(vcpu, 0);
+		return 1;
+	}
+
+	now = kvm_read_l1_tsc(vcpu, rdtsc());
+	if (!svm->rdtsc_initialized) {
+		svm->rdtsc_value = now;
+		svm->rdtsc_initialized = true;
+	} else if (now > svm->rdtsc_previous) {
+		delta = now - svm->rdtsc_previous;
+		svm->rdtsc_value += delta / 20;
+	}
+	svm->rdtsc_previous = now;
+	kvm_register_write(vcpu, VCPU_REGS_RAX, (u32)svm->rdtsc_value);
+	kvm_register_write(vcpu, VCPU_REGS_RDX, (u32)(svm->rdtsc_value >> 32));
+	return svm_skip_emulated_instruction(vcpu);
+}
+
 static int (*const svm_exit_handlers[])(struct kvm_vcpu *vcpu) = {
+	[SVM_EXIT_RDTSC] = rdtsc_experiment_interception,
 	[SVM_EXIT_READ_CR0]			= cr_interception,
 	[SVM_EXIT_READ_CR3]			= cr_interception,
 	[SVM_EXIT_READ_CR4]			= cr_interception,
